{
  "name": "crosstalk-ai",
  "version": "0.1.0",
  "description": "Multi-agent development where a code-review finding is a claim, not a command.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crosstalk": "./dist/cli/index.js",
    "ct": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/harness/harnesses.yaml",
    "src/harness/templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:ui": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "node-pty": "^1.1.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
